@@ -568,0 +569 @@ var mesh_frag_default = "precision mediump float;\n\nvarying vec3 v_color;\nvarying vec2 v_uv;\nuniform sampler2D u_texture;\nuniform float u_volume;\nuniform float u_alpha;\nuniform float u_sinAngle;\nuniform float u_cosAngle;\n\n// 预计算常量\nconst float INV_255 = 1.0 / 255.0;\nconst float HALF_INV_255 = 0.5 / 255.0;\nconst float GRADIENT_NOISE_A = 52.9829189;\nconst vec2 GRADIENT_NOISE_B = vec2(0.06711056, 0.00583715);\n\nfloat gradientNoise(in vec2 uv) {\n    return fract(GRADIENT_NOISE_A * fract(dot(uv, GRADIENT_NOISE_B)));\n}\n\nvoid main() {\n    float volumeEffect = u_volume * 2.0;\n\n    float dither = INV_255 * gradientNoise(gl_FragCoord.xy) - HALF_INV_255;\n\n    vec2 centeredUV = v_uv - vec2(0.2);\n\n    vec2 rotatedUV = vec2(\n        u_cosAngle * centeredUV.x - u_sinAngle * centeredUV.y,\n        u_sinAngle * centeredUV.x + u_cosAngle * centeredUV.y\n    );\n\n    vec2 finalUV = rotatedUV * max(0.001, 1.0 - volumeEffect) + vec2(0.5);\n    \n    vec4 result = texture2D(u_texture, finalUV);\n    \n    float alphaVolumeFactor = u_alpha * max(0.5, 1.0 - u_volume * 0.5);\n    result.rgb *= v_color * alphaVolumeFactor;\n    result.a *= alphaVolumeFactor;\n    \n    result.rgb += vec3(dither);\n    \n    float dist = distance(v_uv, vec2(0.5));\n    float vignette = smoothstep(0.8, 0.3, dist);\n    float mask = 0.6 + vignette * 0.4;\n    result.rgb *= mask;\n    \n    gl_FragColor = result;\n}\n";
+mesh_frag_default = mesh_frag_default.replace("vec2 centeredUV = v_uv - vec2(0.2);", "vec2 centeredUV = v_uv - vec2(0.5);");
@@ -1144,0 +1145,4 @@ var MeshGradientRenderer = class extends BaseRenderer {
+	rhythmBaseline = 0;
+	rhythmPhase = 0;
+	rhythmBreath = 0;
+	rhythmInitialized = false;
@@ -1266,2 +1270,19 @@ var MeshGradientRenderer = class extends BaseRenderer {
-		const lerpFactor = Math.min(1, delta / 100);
-		this.smoothedVolume += (this.volume - this.smoothedVolume) * lerpFactor;
+		const safeDelta = Number.isFinite(delta) ? Math.max(0, delta) : 0;
+		const lerpFactor = 1 - Math.exp(-safeDelta / 55);
+		this.smoothedVolume += (this.volume - this.smoothedVolume) * lerpFactor;
+		const signal = Math.min(1, Math.max(0, this.smoothedVolume * 25));
+		if (!this.rhythmInitialized) {
+			this.rhythmBaseline = signal;
+			this.rhythmInitialized = true;
+		}
+		const accent = Math.max(0, signal - this.rhythmBaseline);
+		const baselineFactor = 1 - Math.exp(-safeDelta / 900);
+		this.rhythmBaseline += (signal - this.rhythmBaseline) * baselineFactor;
+		const rotationSpeed = Math.min(2.6, accent * 3.2);
+		this.rhythmPhase = (this.rhythmPhase + rotationSpeed * safeDelta / 1e3) % (Math.PI * 2);
+		const targetBreath = Math.min(.075, Math.max(0, this.rhythmBaseline * .09 + accent * .09));
+		const breathMs = targetBreath > this.rhythmBreath ? 90 : 360;
+		const breathFactor = 1 - Math.exp(-safeDelta / breathMs);
+		this.rhythmBreath += (targetBreath - this.rhythmBreath) * breathFactor;
+		const breathVolume = this.rhythmBreath;
+		const compensatedAlpha = 1 / Math.max(.5, 1 - breathVolume * .5);
@@ -1278,3 +1300,3 @@ var MeshGradientRenderer = class extends BaseRenderer {
-			this.mainProgram.setUniform1f("u_volume", this.volume);
-			this.mainProgram.setUniform1f("u_alpha", 1);
-			const angle = (uTime + this.volume) * 2;
+			this.mainProgram.setUniform1f("u_volume", breathVolume);
+			this.mainProgram.setUniform1f("u_alpha", compensatedAlpha);
+			const angle = uTime * 2 + this.rhythmPhase;
@@ -1369,0 +1391,5 @@ var MeshGradientRenderer = class extends BaseRenderer {
+		this.volume = 0;
+		this.smoothedVolume = 0;
+		this.rhythmBaseline = 0;
+		this.rhythmBreath = 0;
+		this.rhythmInitialized = false;
@@ -1474 +1501,2 @@ var MeshGradientRenderer = class extends BaseRenderer {
-		this.volume = volume / 10;
+		const safeVolume = Number.isFinite(volume) ? Math.min(1, Math.max(0, volume)) : 0;
+		this.volume = safeVolume / 10;
